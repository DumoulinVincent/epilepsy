# ---------------------------------------------------------------- local only
# Everything from before the paper cleanup that is not in the new layout (old notebooks, v1/v3 pipelines,
# their results). The committed version of all of it is the tag `archive-2026-11`.
_old/

# Python / Jupyter / editor
__pycache__/
*.pyc
.ipynb_checkpoints/
*:Zone.Identifier
*Zone.Identifier

# LaTeX build files (the PDFs are kept)
*.aux
*.log
*.out
*.toc
*.synctex.gz

# Brian2 network states (net.store): ~165 MB each, regenerable with spiking_network/make_baselines.py
*.bri

# ---------------------------------------------------------------- simulation results
# Raw runs are several GB and live outside git (see README.md, "Data"). Only the small derived tables that the
# paper and poster figures read are versioned.
spiking_network/results/**
!spiking_network/results/**/
!spiking_network/results/README.md
!spiking_network/results/lfp_tau250_15k/treatment/*.csv
!spiking_network/results/lfp_tau250_15k/ews/*.csv
!spiking_network/results/lfp_tau250_15k/entropy/*.csv
!spiking_network/results/lfp_tau250_20k/treatment/*.csv
!spiking_network/results/image_random_c16/analysis/summary.csv
!spiking_network/results/image_c16_dbs300/analysis/summary.csv
!spiking_network/results/long_tau/raw/*.npz

# Paper and poster: kept locally in manuscripts/ (separate, private); not part of the public repository
manuscripts/

# Epileptor probes: per-process scratch
epileptor/results/probe_work/
*.bbl
*.blg
